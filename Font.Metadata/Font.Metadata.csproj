<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fonts.Metadata</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Font.Metadata</PackageId>
    <Description>Read SFNT and TTC font metadata on .NET 10 with partial results, table statuses and structured diagnostics.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Font.Metadata.Tests" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
