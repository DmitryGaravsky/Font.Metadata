<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fonts.Metadata.Tool</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>font-metadata</ToolCommandName>
    <PackageId>Font.Metadata.Tool</PackageId>
    <Description>Inspect font metadata from files or binary stdin with plain/JSON reports, diagnostics and optional license evidence.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Font.Metadata.Tool.Tests" />
    <ProjectReference Include="../Font.Metadata.Spdx/Font.Metadata.Spdx.csproj" />
    <PackageReference Include="Spdx.Expressions" GeneratePathProperty="true" />
    <None Include="$(PkgSpdx_Expressions)/LICENSE" Link="notices/Spdx.Expressions/LICENSE" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <None Include="$(PkgSpdx_Expressions)/THIRD-PARTY-NOTICES.md" Link="notices/Spdx.Expressions/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <None Include="$(PkgSpdx_Expressions)/data/UPSTREAM*.md" Link="notices/Spdx.Expressions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
