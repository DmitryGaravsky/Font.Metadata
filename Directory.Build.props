<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <Version>0.1.0-dev</Version>
    <Authors>Dmitry Garavsky</Authors>
    <Copyright>Copyright (c) 2026 Dmitry Garavsky</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DmitryGaravsky/Font.Metadata</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DmitryGaravsky/Font.Metadata</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>font;metadata;opentype;truetype;woff;eot</PackageTags>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
