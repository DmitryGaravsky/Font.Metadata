{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Font.Metadata.Tool inspect report, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "options": {
      "type": "object",
      "properties": {
        "includeNameRecords": {
          "type": "boolean"
        },
        "analyzeLicenses": {
          "type": "boolean"
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483590
        },
        "analyzeSpdx": {
          "const": true
        }
      },
      "required": [
        "includeNameRecords",
        "analyzeLicenses",
        "maxInputBytes"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      },
      "minItems": 1
    },
    "spdxContext": {
      "$ref": "#/$defs/spdxContext"
    }
  },
  "required": [
    "schemaVersion",
    "options",
    "results"
  ],
  "$defs": {
    "section": {
      "type": "string",
      "enum": [
        "notRead",
        "missing",
        "complete",
        "partial",
        "invalid",
        "unsupported"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "stdin"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "path": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "nameId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "platformId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "encodingId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "languageId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "languageTag": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "nameId",
        "platformId",
        "encodingId",
        "languageId",
        "languageTag",
        "value"
      ]
    },
    "hint": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "identifierKind": {
          "type": "string",
          "enum": [
            "spdx",
            "family"
          ]
        },
        "ruleId": {
          "type": "string"
        },
        "sourceRecord": {
          "$ref": "#/$defs/record"
        }
      },
      "required": [
        "identifier",
        "identifierKind",
        "ruleId",
        "sourceRecord"
      ]
    },
    "analysis": {
      "type": "object",
      "properties": {
        "isSourceComplete": {
          "type": "boolean"
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hint"
          }
        }
      },
      "required": [
        "isSourceComplete",
        "hints"
      ]
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "malformedData",
            "limitExceeded",
            "unsupportedFeature",
            "unsupportedEncoding",
            "nonConformantData",
            "io"
          ]
        },
        "message": {
          "type": "string"
        },
        "faceIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647
        },
        "tableTag": {
          "type": [
            "string",
            "null"
          ]
        },
        "byteOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "tableByteOffset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "code",
        "severity",
        "category",
        "message",
        "faceIndex",
        "tableTag",
        "byteOffset",
        "tableByteOffset"
      ]
    },
    "face": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "source": {
          "type": "string",
          "enum": [
            "container",
            "eotMain",
            "eotEudc"
          ]
        },
        "sfntFlavor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "nameTableStatus": {
          "$ref": "#/$defs/section"
        },
        "os2TableStatus": {
          "$ref": "#/$defs/section"
        },
        "vendorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "embeddingPermissions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "familyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "subfamilyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "fullName": {
          "type": [
            "string",
            "null"
          ]
        },
        "postScriptName": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "copyright": {
          "type": [
            "string",
            "null"
          ]
        },
        "trademark": {
          "type": [
            "string",
            "null"
          ]
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        },
        "designer": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendorUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "designerUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "licenseDescription": {
          "type": [
            "string",
            "null"
          ]
        },
        "licenseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "nameRecords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "licenseAnalysis": {
          "$ref": "#/$defs/analysis"
        },
        "spdxAnalysis": {
          "$ref": "#/$defs/spdxAnalysis"
        }
      },
      "required": [
        "index",
        "source",
        "sfntFlavor",
        "nameTableStatus",
        "os2TableStatus",
        "vendorId",
        "embeddingPermissions",
        "familyName",
        "subfamilyName",
        "fullName",
        "postScriptName",
        "version",
        "copyright",
        "trademark",
        "manufacturer",
        "designer",
        "description",
        "vendorUrl",
        "designerUrl",
        "licenseDescription",
        "licenseUrl"
      ]
    },
    "eot": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "flags": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "embeddingPermissions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "familyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "styleName": {
          "type": [
            "string",
            "null"
          ]
        },
        "fullName": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "eudcCodePage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "eudcFlags": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "eudcFontDataSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "formatVersion",
        "flags",
        "embeddingPermissions",
        "familyName",
        "styleName",
        "fullName",
        "version",
        "eudcCodePage",
        "eudcFlags",
        "eudcFontDataSize"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "unknown",
            "sfnt",
            "collection",
            "woff",
            "woff2",
            "eot"
          ]
        },
        "eotHeaderStatus": {
          "$ref": "#/$defs/section"
        },
        "eot": {
          "anyOf": [
            {
              "$ref": "#/$defs/eot"
            },
            {
              "type": "null"
            }
          ]
        },
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/face"
          }
        }
      },
      "required": [
        "format",
        "eotHeaderStatus",
        "eot",
        "faces"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "failed",
            "unsupported",
            "notRecognized",
            "ioError"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/metadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "source",
        "status",
        "metadata",
        "diagnostics"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ioError",
                  "notRecognized"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "metadata": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ioError"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "code": {
                      "const": "CLI_IO_ERROR"
                    },
                    "severity": {
                      "const": "error"
                    },
                    "category": {
                      "const": "io"
                    },
                    "faceIndex": {
                      "type": "null"
                    },
                    "tableTag": {
                      "type": "null"
                    },
                    "byteOffset": {
                      "type": "null"
                    },
                    "tableByteOffset": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "code",
                    "severity",
                    "category",
                    "faceIndex",
                    "tableTag",
                    "byteOffset",
                    "tableByteOffset"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "spdxSpan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "start",
        "length"
      ]
    },
    "spdxDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "span": {
          "$ref": "#/$defs/spdxSpan"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "span",
        "message"
      ]
    },
    "spdxOccurrence": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/spdxSpan"
        },
        "role": {
          "type": "string",
          "enum": [
            "license",
            "exception"
          ]
        },
        "lookupStatus": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "wrongKind"
          ]
        },
        "canonicalIdentifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "isDeprecated": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "identifier",
        "span",
        "role",
        "lookupStatus",
        "canonicalIdentifier",
        "isDeprecated"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "lookupStatus": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "canonicalIdentifier": {
                "type": "string",
                "minLength": 1
              },
              "isDeprecated": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "properties": {
              "canonicalIdentifier": {
                "type": "null"
              },
              "isDeprecated": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "spdxValidation": {
      "type": "object",
      "properties": {
        "hasIdentifierErrors": {
          "type": "boolean"
        },
        "hasUnresolvedReferences": {
          "type": "boolean"
        },
        "diagnosticsTruncated": {
          "type": "boolean"
        },
        "identifierOccurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spdxOccurrence"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "documentId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "licenseId": {
                "type": "string",
                "minLength": 1
              },
              "span": {
                "$ref": "#/$defs/spdxSpan"
              }
            },
            "required": [
              "documentId",
              "licenseId",
              "span"
            ]
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spdxDiagnostic"
          }
        }
      },
      "required": [
        "hasIdentifierErrors",
        "hasUnresolvedReferences",
        "diagnosticsTruncated",
        "identifierOccurrences",
        "references",
        "diagnostics"
      ]
    },
    "spdxDeclaration": {
      "type": "object",
      "properties": {
        "ruleId": {
          "type": "string",
          "enum": [
            "FSI001",
            "FSI002"
          ]
        },
        "sourceRecord": {
          "allOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "properties": {
                "nameId": {
                  "const": 13
                }
              }
            }
          ]
        },
        "sourceStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sourceLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "expressionText": {
          "type": "string"
        },
        "parseStatus": {
          "type": "string",
          "enum": [
            "success",
            "invalidSyntax",
            "limitExceeded"
          ]
        },
        "parseDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spdxDiagnostic"
          }
        },
        "validation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/spdxValidation"
            }
          ]
        }
      },
      "required": [
        "ruleId",
        "sourceRecord",
        "sourceStart",
        "sourceLength",
        "expressionText",
        "parseStatus",
        "parseDiagnostics",
        "validation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "parseStatus": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "validation": {
                "$ref": "#/$defs/spdxValidation"
              },
              "parseDiagnostics": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "validation": {
                "type": "null"
              },
              "parseDiagnostics": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ruleId": {
                "const": "FSI002"
              }
            }
          },
          "then": {
            "properties": {
              "parseStatus": {
                "const": "success"
              }
            }
          }
        }
      ]
    },
    "spdxAdapterDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "FSI_SOURCE_RECORD_LIMIT",
            "FSI_SOURCE_CHARACTER_LIMIT",
            "FSI_DECLARATION_LIMIT",
            "FSI_PROBE_PARSE_LIMIT"
          ]
        },
        "message": {
          "type": "string"
        },
        "sourceRecord": {
          "$ref": "#/$defs/record"
        }
      },
      "required": [
        "code",
        "message",
        "sourceRecord"
      ]
    },
    "spdxAnalysis": {
      "type": "object",
      "properties": {
        "isSourceComplete": {
          "type": "boolean"
        },
        "isAnalysisComplete": {
          "type": "boolean"
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spdxDeclaration"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spdxAdapterDiagnostic"
          }
        },
        "diagnosticsTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "isSourceComplete",
        "isAnalysisComplete",
        "declarations",
        "diagnostics",
        "diagnosticsTruncated"
      ]
    },
    "spdxContext": {
      "type": "object",
      "properties": {
        "recognitionProfile": {
          "const": "font-name13-v1"
        },
        "syntaxProfile": {
          "const": "SPDX-2.3.1"
        },
        "registry": {
          "type": "object",
          "properties": {
            "licenseListVersion": {
              "type": "string",
              "minLength": 1
            },
            "licensesSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "exceptionsSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "licenseListVersion",
            "licensesSha256",
            "exceptionsSha256"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "maxSourceRecords": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxTotalSourceCharacters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxDeclarations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxDiagnostics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "parseOptions": {
              "type": "object",
              "properties": {
                "maxInputLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxIdentifierLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxTokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxNodes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "maxParenthesisDepth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                }
              },
              "required": [
                "maxInputLength",
                "maxIdentifierLength",
                "maxTokens",
                "maxNodes",
                "maxParenthesisDepth"
              ]
            },
            "validationOptions": {
              "type": "object",
              "properties": {
                "maxDiagnostics": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              },
              "required": [
                "maxDiagnostics"
              ]
            }
          },
          "required": [
            "maxSourceRecords",
            "maxTotalSourceCharacters",
            "maxDeclarations",
            "maxDiagnostics",
            "parseOptions",
            "validationOptions"
          ]
        }
      },
      "required": [
        "recognitionProfile",
        "syntaxProfile",
        "registry",
        "options"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "options": {
            "properties": {
              "includeNameRecords": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "metadata": {
                  "properties": {
                    "faces": {
                      "items": {
                        "required": [
                          "nameRecords"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
